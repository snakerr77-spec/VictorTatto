# Porta do servidor (API + site em produção)
PORT=3011

# Senha do painel (/admin). Só é lida na PRIMEIRA execução; depois troque em Ajustes.
ADMIN_PASSWORD=troque-esta-senha

# Onde ficam o banco (db.json) e as fotos enviadas — faça backup desta pasta
# DATA_DIR=./data

# Atrás de proxy reverso (nginx, Caddy, Cloudflare)? Coloque 1
# TRUST_PROXY=1
