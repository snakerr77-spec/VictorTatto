{
  "name": "tattovictor-bw",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "tsx server/index.ts",
    "reset-password": "tsx server/reset-password.ts",
    "build:pages": "tsx scripts/export-static.ts && vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\""
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/unifrakturcook": "^5.3.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
